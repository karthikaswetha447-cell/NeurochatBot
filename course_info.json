                    step=0.05,
                    label="Top-P"
                )
                parameters_view = gr.Markdown("No parameter values yet.")

            with gr.Accordion("🧩 Context Engineering", open=False):
                context_view = gr.Markdown("No context selected yet.")

            with gr.Accordion("🕘 Conversation History", open=False):
                history_view = gr.Markdown("No conversation history yet.")

            with gr.Accordion("📦 Structured Output", open=False):
                output_view = gr.Markdown("No output format detected yet.")
                gr.Markdown(
                    "Supported display formats include JSON, Markdown tables, "
                    "bullet points and numbered lists. The format is detected "
                    "from the chatbot's visible answer."
                )

            with gr.Accordion("🎯 Student Message Classification", open=False):
                classification_view = gr.Markdown(
                    "No classification result yet."
                )

            with gr.Accordion("📊 Response Evaluation", open=False):
                evaluation_view = gr.Markdown(
                    "No evaluation result yet."
                )

            with gr.Accordion("🧪 Prompt Engineering", open=False):
                gr.Markdown("""
### Prompt techniques
- **Instruction-based prompting:** Tell the model what task to perform.
- **Constraint-based prompting:** Set rules the answer should follow.
- **Zero-shot prompting:** Ask for a task without examples.
- **Few-shot prompting:** Give examples before asking for the task.

### Limitations
- **Hallucination:** AI may produce incorrect information.
- **Ambiguity:** Unclear prompts can cause unclear answers.
- **Inconsistent output:** Responses may vary.
- **Context limitation:** The model has a finite context window.
- **Instruction following:** The model may not follow every rule.
                """)

            with gr.Accordion("🛡️ System Prompt Information", open=False):
                gr.Markdown("""
NeuroBot's system instructions define its role as a student assistant,
request simple and helpful answers, and require official course information
for course-related facts. Private API keys are never displayed here.
                """)

    outputs = [
        chatbot,
        message_box,
        prompt_view,
        parameters_view,
        context_view,
        history_view,
        classification_view,
        evaluation_view,
        output_view
    ]

    inputs = [
        message_box,
        chatbot,
        temperature,
        max_output_tokens,
        top_p
    ]

    send_button.click(
        fn=send_message,
        inputs=inputs,
        outputs=outputs
    )

    message_box.submit(
        fn=send_message,
        inputs=inputs,
        outputs=outputs
    )

    clear_button.click(
        fn=clear_dashboard,
        inputs=[],
        outputs=outputs
    )


