def _example(message, role="Default NeuroBot", technique="Zero-shot",
             output_format="Normal text", temperature=0.7):
    # Order must match the additional_inputs of the chat:
    # name, level, interests, goal, use_profile, use_history, role,
    # technique, format, temperature, max_tokens, top_p, freq, pres,
    # show_classification, show_evaluation
    return [
        message, "", "Beginner", "", "",
        True, True, role, technique, output_format,
        temperature, 1024, 1.0, 0.0, 0.0,
        False, True,
    ]


PROMPT_EXAMPLES = [
    # Prompting techniques
    _example("What is overfitting in machine learning?", technique="Zero-shot"),
    _example("What is overfitting in machine learning?", technique="Few-shot"),
    _example("A course costs 12000 rupees with 18% GST. What is the total?", technique="Chain-of-Thought"),
    _example("How do I start learning AI from zero?", technique="Step-by-Step Plan"),
    _example("What is a neural network?", technique="Constraint-based (concise)"),
    # Structured outputs
    _example("Explain supervised vs unsupervised learning", output_format="JSON"),
    _example("Compare Python, Java and JavaScript for beginners", output_format="Table"),
    # Role-based instructions
    _example("Explain what an API is", role="Friendly Teacher"),
    _example("How can I get my first AI job?", role="Career Mentor"),
    _example("Tell me about Python lists", role="Technical Interviewer"),
    _example("What is the course fee?", role="Student Support Agent"),
    _example("When will I receive my certificate?", role="Student Support Agent"),
]


